#VRML_SIM R2025a utf8
# Generated by `embeddyn mechatronics curtain-webots` from a light-curtain bench file.
# The obstacles are static Solids (drag them in the 3-D view); the supervisor
# robot "spect" runs embeddyn's scan algorithms on the IrLightCurtain heads.

EXTERNPROTO "../protos/IrLightCurtain.proto"

WorldInfo {
  info [ "spect-curtain: infrared light-curtain bench (embeddyn)" ]
  basicTimeStep 8
}
Viewpoint {
  orientation -0.1822 0.0621 0.9813 2.496
  position 1.9 -1.35 0.85
}
Background {
  skyColor [ 0.16 0.18 0.22 ]
}
DirectionalLight {
  direction -0.4 0.5 -1
  intensity 2.2
  castShadows TRUE
}
DirectionalLight {
  direction 0.5 -0.3 0.6
  intensity 0.6
}
Pose {
  translation 0 0 -0.9
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.55 0.57 0.6 roughness 0.9 metalness 0 }
      geometry Plane { size 6 6 }
    }
  ]
}
DEF TORSO Solid {
  translation 0 0 0
  rotation 0 0 1 0
  name "torso"
  children [ Transform { scale 0.45 0.17 0.11 children [ Shape { appearance PBRAppearance { baseColor 0.93 0.76 0.62 roughness 0.7 metalness 0 } geometry Sphere { radius 1 subdivision 4 } } ] } ]
}
DEF ARM_L Solid {
  translation 0 0.235 0
  rotation 0 1 0 1.5708
  name "arm_l"
  children [ Shape { appearance PBRAppearance { baseColor 0.93 0.76 0.62 roughness 0.7 metalness 0 } geometry Capsule { radius 0.045 height 0.6 subdivision 16 } } ]
}
DEF ARM_R Solid {
  translation 0 -0.235 0
  rotation 0 1 0 1.5708
  name "arm_r"
  children [ Shape { appearance PBRAppearance { baseColor 0.93 0.76 0.62 roughness 0.7 metalness 0 } geometry Capsule { radius 0.045 height 0.6 subdivision 16 } } ]
}
DEF HEAD Solid {
  translation 0.56 0 0.02
  rotation 0 0 1 0
  name "head"
  children [ Shape { appearance PBRAppearance { baseColor 0.93 0.76 0.62 roughness 0.7 metalness 0 } geometry Sphere { radius 0.095 subdivision 3 } } ]
}
DEF COUCH Solid {
  translation 0 0 -0.125
  rotation 0 0 1 0
  name "couch"
  children [ Shape { appearance PBRAppearance { baseColor 0.35 0.38 0.42 roughness 0.7 metalness 0 } geometry Box { size 2 0.5 0.03 } } ]
}
DEF SPECT Robot {
  name "spect"
  supervisor TRUE
  controller "light_curtain"
  controllerArgs [ "--config" "../../light-curtain/spect-curtain.yaml" ]
  children [
    DEF GANTRY Pose {
      children [
        Pose {
          translation 0.32 0 0
          rotation 0 1 0 1.5708
          children [
            Shape {
              appearance PBRAppearance { baseColor 0.6 0.62 0.66 transparency 0.75 roughness 0.5 }
              geometry Cylinder { radius 0.62 height 0.04 subdivision 64 }
            }
          ]
        }
      DEF HEAD_A Pose {
        rotation 1 0 0 0
        children [
          DEF SLIDE_A Pose {
            translation 0 0 0.35
            children [
              Pose {
                translation 0 0 0.06
                children [
                  Shape {
                    appearance PBRAppearance { baseColor 0.75 0.78 0.82 roughness 0.4 metalness 0.3 }
                    geometry Box { size 0.4 0.54 0.12 }
                  }
                ]
              }
              DEF CURTAIN_A Pose {
                translation 0 0 -0.012
                children [
          IrLightCurtain {
            name "a_curtain"
            prefix "a_"
            count 16
            pitch 0.024
            span 0.58
            receiverOffset 0
            emitterIntensity 0.01
            emitterPower 0
            emitterHalfAngle 10
            emitterAperture 0.003
            emitterDrive 1
            emitterTilt 0
            emitterYaw 0
            tiltSigma 0.5
            intensitySpread 0.1
            receiverHalfAngle 20
            receiverArea 7e-06
            receiverAperture 0.003
            algorithm "sequential"
            algorithmParams "{}"
          }
                ]
              }
            ]
          }
        ]
      }
      DEF HEAD_B Pose {
        rotation 1 0 0 3.14159
        children [
          DEF SLIDE_B Pose {
            translation 0 0 0.35
            children [
              Pose {
                translation 0 0 0.06
                children [
                  Shape {
                    appearance PBRAppearance { baseColor 0.75 0.78 0.82 roughness 0.4 metalness 0.3 }
                    geometry Box { size 0.4 0.54 0.12 }
                  }
                ]
              }
              DEF CURTAIN_B Pose {
                translation 0 0 -0.012
                children [
          IrLightCurtain {
            name "b_curtain"
            prefix "b_"
            count 16
            pitch 0.024
            span 0.58
            receiverOffset 0
            emitterIntensity 0.01
            emitterPower 0
            emitterHalfAngle 10
            emitterAperture 0.003
            emitterDrive 1
            emitterTilt 0
            emitterYaw 0
            tiltSigma 0.5
            intensitySpread 0.1
            receiverHalfAngle 20
            receiverArea 7e-06
            receiverAperture 0.003
            algorithm "sequential"
            algorithmParams "{}"
          }
                ]
              }
            ]
          }
        ]
      }
      ]
    }
  ]
}
