// Sensors of the arm-joint example (firmware/arm-joint-l476), on top of
// stm32l476-servo.repl. Needs Renode >= 1.17.

gpioPortB: GPIOPort.STM32_GPIOPort @ sysbus <0x48000400, +0x400>
    modeResetValue: 0xFFFFFEBF
    numberOfAFs: 16

// SPI1 (PB3/4/5, CS PB6). The L4 SPI is the L5 IP (DS, FRXTH).
spi1: SPI.STM32SPI @ sysbus 0x40013000
    series: STM32Series.L5
    IRQ -> nvic@35

// AS5047P absolute angle sensor on the joint. The device itself is modelled in
// embeddyn (spi_devices.AS5047P), which answers every byte through External
// Control (instance option `spi:` with peripheral sysbus.spi1.abs_encoder).
abs_encoder: SPI.ExternalControlSPIPeripheral @ spi1

// I2C1 (PB8/PB9) with Renode's AS6221 temperature sensor on the motor winding.
i2c1: I2C.STM32F7_I2C @ sysbus 0x40005400
    EventInterrupt -> nvic@31
    ErrorInterrupt -> nvic@32

motor_temp: Sensors.AS6221 @ i2c1 0x48

// Sensor feed bridge: not hardware. embeddyn writes a float32 into a slot with
// an ordinary `sysbus` input binding before each step; the script sets the
// named property of a sensor model to that value. That keeps the feed
// deterministic (it lands before the step runs) and works with either
// External Control protocol. Add a slot per sensor quantity in TARGETS.
sensor_feed: Python.PythonPeripheral @ sysbus 0x5F000000
    size: 0x40
    initable: true
    script: '''
if request.IsInit:
    from System import BitConverter, Convert, UInt32
    from Antmicro.Renode.Core import EmulationManager
    TARGETS = {0x00: ("sysbus.i2c1.motor_temp", "Temperature")}
    values = {}
    resolved = {}
elif request.IsWrite:
    values[request.Offset] = request.Value
    if request.Offset in TARGETS:
        path, name = TARGETS[request.Offset]
        if path not in resolved:
            found, machine = EmulationManager.Instance.CurrentEmulation.TryGetMachineForPeripheral(self)
            target = machine[path]
            resolved[path] = (target, target.GetType().GetProperty(name))
        target, prop = resolved[path]
        number = BitConverter.ToSingle(BitConverter.GetBytes(UInt32(request.Value & 0xFFFFFFFF)), 0)
        prop.SetValue(target, Convert.ChangeType(float(number), prop.PropertyType), None)
elif request.IsRead:
    request.Value = values.get(request.Offset, 0)
'''
